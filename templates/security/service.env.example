# Minimal variant: copy this to a private local path such as:
#   $HOME/.config/agent-secrets/service.env
#
# Then lock it down:
#   chmod 600 $HOME/.config/agent-secrets/service.env
#
# Keep real values out of repos, logs, screenshots, memory, and public docs.

OPENCLAW_PROVIDER_TOKEN=<secret>
OPENCLAW_WEBHOOK_URL=<secret>
BRIGADE_GUARD_POLICY=<local-policy-path>
SCRUB_RULES=<local-rules-path>

# Render variant: a TEMPLATE holds references instead of values, and a oneshot
# unit renders the real env file into $XDG_RUNTIME_DIR (tmpfs) at 0600.
# NEVER source a template. Sourcing exports the literal reference strings.
#
#   OPENCLAW_PROVIDER_TOKEN=op://<runtime-vault>/<item>/<field>
#   OPENCLAW_WEBHOOK_URL=op://<runtime-vault>/<item>/<field>
#   LEGACY_TOKEN=keepass://<entry-title>
#
# See security/secret-management.md, section 5.
