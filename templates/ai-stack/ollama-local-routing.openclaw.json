{
  "memory": {
    "citations": "auto",
    "search": {
      "provider": "openai",
      "remote": {
        "baseUrl": "http://127.0.0.1:11434/v1/",
        "apiKey": "<ollama-placeholder-key>"
      },
      "fallback": "none",
      "model": "qwen3-embedding:8b"
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "ollama/<local-utility-model>": {
          "alias": "localUtility",
          "params": {
            "temperature": 0,
            "numPredict": 256
          }
        }
      }
    }
  }
}
